+    },
+    "f11": {
+      "q": "How do I change my phone number?",
+      "a": "Go to Profile > Settings Hub > Account Settings to update your registered phone number."
+    },
+    "f12": {
+      "q": "How do I delete my account?",
+      "a": "You can delete your account from Profile > Settings Hub > Account Settings > Delete Account. Please note this action is permanent."
+    }
